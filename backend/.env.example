# Copia este archivo como .env y ajusta valores. NUNCA subas .env al repositorio.
PORT=3000
DATABASE_URL=postgres://taskmanager:taskmanager@localhost:5434/taskmanager
# Base aislada para las pruebas (debe terminar en _test).
TEST_DATABASE_URL=postgres://test:test@localhost:5433/taskmanager_test
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
CORS_ORIGINS=http://localhost:8080
