{
  "name": "task-manager-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Task Manager (Express + PostgreSQL + JWT con refresh tokens) para practicar testing.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset:test": "node scripts/migrate.js --reset",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:api": "jest --runInBand tests/api",
    "test:coverage": "jest --runInBand --coverage",
    "smoke": "node scripts/smoke.js",
    "explore": "node scripts/explore-api.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
